<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Opt-in launchd keep-alive for scripts/capture-listener.mjs — NOT loaded by
  default. See the "Keep-alive" section in this directory's README or the
  comment block at the top of capture-listener.mjs for what this does.

  Before loading: stop any manually-started listener first (this plist binds
  the same port, 4411 by default — two listeners racing for the same port
  means the second one to bind just fails silently in its log, not a crash,
  but only one will actually be serving).

  Install (per-user agent, runs at login, restarts on crash):
    cp scripts/com.jhd.capture-listener.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.jhd.capture-listener.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.jhd.capture-listener.plist
    rm ~/Library/LaunchAgents/com.jhd.capture-listener.plist

  The conformance-check hook is on by default under launchd (CONFORMANCE_MAP_PATH
  below, pointed at portfolio's figma-map.json) — edit or remove the
  EnvironmentVariables entry to point elsewhere or opt back out.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jhd.capture-listener</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/jarradharvey/.claude/plugins/marketplaces/discipline/scripts/capture-listener.mjs</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/jarradharvey/Library/Logs/capture-listener.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jarradharvey/Library/Logs/capture-listener.error.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>CONFORMANCE_MAP_PATH</key>
    <string>/Users/jarradharvey/JHD/portfolio/design/figma-map.json</string>
  </dict>
</dict>
</plist>
